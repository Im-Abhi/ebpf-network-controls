# Shell scripts and systemd units must keep LF endings — CRLF breaks
# bash shebangs and systemd parsing on Linux.
*.sh      text eol=lf
*.service text eol=lf

# Go sources normalize to LF in the repo.
*.go      text eol=lf

# Makefiles need LF or make errors out with "missing separator".
Makefile  text eol=lf
